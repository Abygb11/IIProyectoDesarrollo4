@model List<Raza>
@{ ViewData["Title"] = "Razas"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Razas</h2>
    <a class="btn btn-primary" asp-action="Crear">Nueva raza</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input name="q" value="@ViewBag.Q" class="form-control" placeholder="Buscar por nombre" />
    </div>
    <div class="col-auto">
        <select name="especieId" class="form-select" asp-items="ViewBag.Especies">
            <option value="">Todas las especies</option>
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary">Buscar</button>
        <a asp-action="Index" class="btn btn-link">Limpiar</a>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr><th>Raza</th><th>Especie</th><th class="text-end">Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Nombre</td>
                <td>@r.Especie?.Nombre</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@r.Id">Editar</a>
                    <form asp-action="Eliminar" asp-route-id="@r.Id" method="post" class="d-inline"
                          onsubmit="return confirm('¿Eliminar esta raza?');">
                        <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="3" class="text-center text-muted">No hay razas registradas.</td></tr>
        }
    </tbody>
</table>