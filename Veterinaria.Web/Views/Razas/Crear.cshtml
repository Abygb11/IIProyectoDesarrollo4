@model Raza
@{ ViewData["Title"] = "Nueva raza"; }

<h2 class="mb-3">Nueva raza</h2>

<form asp-action="Crear" method="post" class="col-md-5">
    <div class="mb-3">
        <label asp-for="EspecieId" class="form-label">Especie</label>
        <select asp-for="EspecieId" class="form-select" asp-items="ViewBag.Especies">
            <option value="">-- Seleccione --</option>
        </select>
        <span asp-validation-for="EspecieId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Nombre" class="form-label">Nombre de la raza</label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <button class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>