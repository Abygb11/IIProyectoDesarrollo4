@* muestra el editor de texto enriquecido para agregar una nota y el historial clínico
   de la mascota, de la más reciente a la más antigua. Las notas no se pueden editar ni eliminar. *@
@model Veterinaria.Web.ViewModels.NotasVM
@{ ViewData["Title"] = "Historial clínico"; }

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css" />

<a href="/Mascotas/Expediente/@Model.Mascota.Id" class="btn btn-link ps-0">&larr; Volver al expediente</a>
<h2>Historial clínico de @Model.Mascota.Nombre</h2>

<form asp-action="Crear" method="post" id="formNota" class="card card-body mb-4">
  <input type="hidden" asp-for="Form.MascotaId" />
  <input type="hidden" asp-for="Form.ContenidoHtml" />

  <label class="form-label">Nueva nota</label>
  <div id="editor" style="height:180px;background:#fff;"></div>
  <div asp-validation-summary="All" class="text-danger mt-2"></div>

  <div class="mt-3">
    <button class="btn btn-primary">Guardar nota</button>
  </div>
</form>

@foreach (var n in Model.Notas)
{
  <div class="card mb-3">
    <div class="card-header d-flex justify-content-between">
      <span>@n.FechaHora.ToString("dd/MM/yyyy HH:mm")</span>
      <small class="text-muted">@n.Autor?.Nombre</small>
    </div>
    <div class="card-body">
      @* El HTML ya se sanitizó al guardar la nota *@
      @Html.Raw(n.ContenidoHtml)
    </div>
  </div>
}
@if (!Model.Notas.Any())
{
  <p class="text-muted text-center">Sin notas en el historial.</p>
}

@section Scripts {
  <script src="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.min.js"></script>
  <script>
    // Editor de texto enriquecido con negrita, cursiva, subrayado y listas
    var quill = new Quill('#editor', {
      theme: 'snow',
      placeholder: 'Escribe la nota clínica...',
      modules: {
        toolbar: [['bold', 'italic', 'underline'], [{ list: 'ordered' }, { list: 'bullet' }], ['clean']]
      }
    });

    var campo = document.getElementById('Form_ContenidoHtml');

    // Si el servidor devolvió el formulario con un error, se recupera lo que se había escrito
    if (campo.value) quill.root.innerHTML = campo.value;

    // Al enviar, copia el HTML del editor al campo oculto (vacío si no hay texto)
    document.getElementById('formNota').addEventListener('submit', function () {
      campo.value = quill.getText().trim() === '' ? '' : quill.root.innerHTML;
    });
  </script>
}