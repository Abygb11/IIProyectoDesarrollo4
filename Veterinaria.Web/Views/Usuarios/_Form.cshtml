@using Veterinaria.Web.ViewModels
@model UsuarioFormViewModel
@{
    var esNuevo = ViewData["EsNuevo"] is true;
}

<div class="mb-3">
    <label asp-for="Cedula" class="form-label">Cédula</label>
    <input asp-for="Cedula" class="form-control" />
    <span asp-validation-for="Cedula" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Nombre" class="form-label">Nombre</label>
    <input asp-for="Nombre" class="form-control" />
    <span asp-validation-for="Nombre" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Correo" class="form-label">Correo electrónico</label>
    <input asp-for="Correo" type="email" class="form-control" />
    <span asp-validation-for="Correo" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Password" class="form-label">Contraseña</label>
    <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
    @if (!esNuevo)
    {
        <div class="form-text">Deje este campo vacío para conservar la contraseña actual.</div>
    }
    <span asp-validation-for="Password" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Perfil" class="form-label">Perfil</label>
    <select asp-for="Perfil" class="form-select" asp-items="ViewBag.Perfiles"></select>
    <span asp-validation-for="Perfil" class="text-danger"></span>
</div>
<div class="mb-3" id="grupoVeterinario">
    <label asp-for="VeterinarioId" class="form-label" id="etiquetaVeterinario">Veterinario vinculado</label>
    <select asp-for="VeterinarioId" class="form-select" asp-items="ViewBag.Veterinarios">
        <option value="">-- Ninguno --</option>
    </select>
    <span asp-validation-for="VeterinarioId" class="text-danger"></span>
</div>

<script>
    // Muestra u oculta el veterinario vinculado según el perfil elegido
    (function () {
        var perfil = document.getElementById('Perfil');
        var grupo = document.getElementById('grupoVeterinario');
        var etiqueta = document.getElementById('etiquetaVeterinario');

        function actualizar() {
            var p = perfil.value;
            grupo.style.display = (p === 'Dueno') ? 'none' : '';
            etiqueta.textContent = (p === 'Veterinario')
                ? 'Veterinario vinculado (obligatorio)'
                : 'Veterinario vinculado (opcional)';
        }

        perfil.addEventListener('change', actualizar);
        actualizar();
    })();
</script>