@using Veterinaria.Web.ViewModels
@model UsuarioFormViewModel
@{
    ViewData["Title"] = "Nuevo usuario";
    ViewData["EsNuevo"] = true;
}

<h2 class="mb-3">Nuevo usuario</h2>

<form asp-action="Crear" method="post" class="col-md-6">
    <partial name="_Form" />
    <button class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>