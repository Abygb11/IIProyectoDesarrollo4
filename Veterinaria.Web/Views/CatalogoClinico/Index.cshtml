@model List<ItemClinico>
@{ ViewData["Title"] = "Catálogo clínico"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Catálogo clínico</h2>
    <a class="btn btn-primary" asp-action="Crear">Nuevo ítem</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input name="q" value="@ViewBag.Q" class="form-control" placeholder="Buscar por nombre" />
    </div>
    <div class="col-auto">
        <select name="tipo" class="form-select" asp-items="Html.GetEnumSelectList<TipoItem>()">
            <option value="">Todos los tipos</option>
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary">Buscar</button>
        <a asp-action="Index" class="btn btn-link">Limpiar</a>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr><th>Nombre</th><th>Tipo</th><th>Descripción</th><th class="text-end">Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var i in Model)
        {
            <tr>
                <td>@i.Nombre</td>
                <td>
                    <span class="badge @(i.Tipo == TipoItem.Medicamento ? "bg-info text-dark" : "bg-secondary")">@i.Tipo</span>
                </td>
                <td>@i.Descripcion</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@i.Id">Editar</a>
                    <form asp-action="Eliminar" asp-route-id="@i.Id" method="post" class="d-inline"
                          onsubmit="return confirm('¿Eliminar este ítem?');">
                        <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="4" class="text-center text-muted">No hay ítems registrados.</td></tr>
        }
    </tbody>
</table>