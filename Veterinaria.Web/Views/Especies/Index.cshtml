@model List<Especie>
@{ ViewData["Title"] = "Especies"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Especies</h2>
    <a class="btn btn-primary" asp-action="Crear">Nueva especie</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input name="q" value="@ViewBag.Q" class="form-control" placeholder="Buscar por nombre" />
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary">Buscar</button>
        <a asp-action="Index" class="btn btn-link">Limpiar</a>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr><th>Nombre</th><th class="text-end">Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td>@e.Nombre</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@e.Id">Editar</a>
                    <form asp-action="Eliminar" asp-route-id="@e.Id" method="post" class="d-inline"
                          onsubmit="return confirm('¿Eliminar esta especie?');">
                        <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="2" class="text-center text-muted">No hay especies registradas.</td></tr>
        }
    </tbody>
</table>