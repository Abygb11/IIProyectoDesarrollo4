<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Veterinaria.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Veterinaria.Web.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Veterinaria.Web</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home"
                               asp-action="Index">Inicio</a>
                        </li>

                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" role="button"
                                   data-bs-toggle="dropdown">Administración</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Especies" asp-action="Index">Especies</a></li>
                                    <li><a class="dropdown-item" asp-controller="Razas" asp-action="Index">Razas</a></li>
                                    <li><a class="dropdown-item" asp-controller="CatalogoClinico" asp-action="Index">Catálogo clínico</a></li>
                                    <li><a class="dropdown-item" asp-controller="Veterinarios" asp-action="Index">Veterinarios</a></li>
                                    <li><a class="dropdown-item" asp-controller="Usuarios" asp-action="Index">Usuarios</a></li>
                                </ul>
                            </li>
                        }

                        @if (User.IsInRole("Administrador") || User.IsInRole("Veterinario"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="#">Veterinaria</a>
                            </li>
                        }
                    </ul>

                    @* Usuario autenticado: nombre, rol y cerrar sesión. Si no, botón de iniciar sesión. *@
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form method="post" asp-controller="Cuenta" asp-action="Logout" class="d-flex align-items-center">
                            <span class="me-2">
                                @User.Identity.Name
                                (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)
                            </span>
                            <button class="btn btn-outline-secondary btn-sm">Cerrar sesión</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-primary btn-sm" asp-controller="Cuenta" asp-action="Login">Iniciar sesión</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            <partial name="_Mensajes" />
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Veterinaria.Web
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>