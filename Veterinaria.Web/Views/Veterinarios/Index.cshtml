@model List<Veterinario>
@{ ViewData["Title"] = "Veterinarios"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Veterinarios</h2>
    <a class="btn btn-primary" asp-action="Crear">Nuevo veterinario</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input name="q" value="@ViewBag.Q" class="form-control" placeholder="Nombre o N.º de colegiado" />
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary">Buscar</button>
        <a asp-action="Index" class="btn btn-link">Limpiar</a>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr><th>Foto</th><th>Nombre completo</th><th>N.º de colegiado</th><th class="text-end">Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var v in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(v.FotoRuta))
                    {
                        <img src="@Url.Content("~/" + v.FotoRuta)" alt="Foto de @v.NombreCompleto"
                             class="rounded-circle" style="width:48px;height:48px;object-fit:cover;" />
                    }
                    else
                    {
                        <span class="text-muted">Sin foto</span>
                    }
                </td>
                <td>@v.NombreCompleto</td>
                <td>@v.NumeroColegiado</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@v.Id">Editar</a>
                    <form asp-action="Eliminar" asp-route-id="@v.Id" method="post" class="d-inline"
                          onsubmit="return confirm('¿Eliminar este veterinario?');">
                        <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="4" class="text-center text-muted">No hay veterinarios registrados.</td></tr>
        }
    </tbody>
</table>