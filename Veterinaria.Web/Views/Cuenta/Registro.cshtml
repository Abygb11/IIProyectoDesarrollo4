@model Veterinaria.Web.ViewModels.RegistroVM
@{ ViewData["Title"] = "Crear cuenta"; }

<div class="row justify-content-center">
  <div class="col-md-5">
    <h2 class="mb-3">Crear cuenta de dueño</h2>
    <form method="post">
      <div class="mb-3">
        <label class="form-label">Cédula</label>
        <input asp-for="Cedula" class="form-control" />
        @*Validación para la Cédula para que esté en el formato correcto*@
        <span asp-validation-for="Cedula" class="text-danger"></span>
      </div>
      <div class="mb-3">
        <label class="form-label">Nombre completo</label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
      </div>
      <div class="mb-3">
        <label class="form-label">Correo</label>
        <input asp-for="Correo" class="form-control" />
        <span asp-validation-for="Correo" class="text-danger"></span>
      </div>
      <div class="mb-3">
        <label class="form-label">Contraseña</label>
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
      </div>
      <div class="mb-3">
        <label class="form-label">Confirmar contraseña</label>
        <input asp-for="ConfirmarPassword" class="form-control" />
        <span asp-validation-for="ConfirmarPassword" class="text-danger"></span>
      </div>
      <button class="btn btn-primary w-100">Registrarme</button>
    </form>
    <p class="mt-3 text-center"><a asp-action="Login">Ya tengo cuenta</a></p>
  </div>
</div>